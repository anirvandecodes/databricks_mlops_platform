%%{init: {"flowchart": {"wrappingWidth": 420, "nodeSpacing": 40, "rankSpacing": 50}}}%%
%% Feature contracts repo — the PR lifecycle: what is checked, and when tables are built.
flowchart TB
  PR(["Any team opens a PR<br/>new feature table, or a change to one"])

  subgraph GATE["GitHub Action · Feature contract check — every PR"]
    direction TB
    G1["1 · Contract rule tests"]
    G2["2 · Bundle config resolves"]
    G3["3 · Every features/&lt;table&gt;/ vs main<br/>valid contract + SQL · all environments defined<br/>released features immutable · semver + changelog<br/>SQL compiles (EXPLAIN) · who reads it? (UC lineage)"]
    G1 --> G2 --> G3
  end

  REVIEW["Owning team approves<br/>(CODEOWNERS)"]
  DECIDE{"All checks green<br/>and approved?"}
  BLOCK["Merge blocked<br/>fix · or ship new logic as &lt;name&gt;_v2"]
  MERGE(["Merge to main"])

  subgraph MAIN["Same Action on main"]
    direction TB
    M1["Re-run checks 1–3<br/>(against the commit before the merge)"]
    M2["Deploy bundle → job feature_tables<br/>build tables → provision access"]
    M1 --> M2
  end

  PR --> GATE
  G3 --> DECIDE
  REVIEW --> DECIDE
  DECIDE -->|no| BLOCK
  BLOCK -.->|push a fix| PR
  DECIDE -->|yes| MERGE --> MAIN

  classDef start fill:#1B3139,stroke:#1B3139,color:#ffffff;
  classDef step fill:#FFFFFF,stroke:#5A6F77,color:#1B3139;
  classDef gate fill:#F5F7F8,stroke:#5A6F77,color:#1B3139;
  classDef block fill:#FDECEA,stroke:#C0392B,color:#7B241C;
  classDef ok fill:#E8F5EE,stroke:#1E7E45,color:#0C3A1F;
  classDef run fill:#FFF1EC,stroke:#FF3621,color:#5A1A10;
  class PR,MERGE start;
  class G1,G2,G3,REVIEW step;
  class DECIDE gate;
  class BLOCK block;
  class M1,M2 run;
  style GATE fill:#F5F7F8,stroke:#5A6F77,color:#1B3139
  style MAIN fill:#FFF8F5,stroke:#FF3621,color:#1B3139
